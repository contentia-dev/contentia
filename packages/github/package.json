{
  "name": "@contentia/github",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "GitHub-backed StorageRepository for Contentia. Stores content in a GitHub repository; authenticates as a GitHub App via installation tokens.",
  "keywords": [
    "headless-cms",
    "content-management",
    "github",
    "storage",
    "octokit"
  ],
  "author": {
    "name": "Sem Postma",
    "email": "sem@contentia.dev",
    "url": "https://sem-postma.com"
  },
  "homepage": "https://github.com/contentia-dev/contentia",
  "bugs": {
    "email": "sem@contentia.dev",
    "url": "https://github.com/contentia-dev/contentia/issues"
  },
  "license": "MIT",
  "repository": "https://github.com/contentia-dev/contentia",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./storage-gh": {
      "types": "./dist/storage-gh/index.d.ts",
      "import": "./dist/storage-gh/index.js",
      "default": "./dist/storage-gh/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node ../../scripts/check-no-pnpm-catalog-deps.mjs"
  },
  "dependencies": {
    "contentia": "workspace:*",
    "@octokit/auth-app": "catalog:octokit",
    "@octokit/rest": "catalog:octokit",
    "effect": "catalog:default",
    "minimatch": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "rimraf": "catalog:tools",
    "typescript": "catalog:tools",
    "vitest": "catalog:tools"
  },
  "engines": {
    "node": "24.x"
  }
}
