      "contentia/i18n": [
        "src/shared/i18n/index.ts"
      ],
      "contentia/i18n/en": [
        "src/shared/i18n/translations/en.ts"
      ],
      "contentia/i18n/nl": [
        "src/shared/i18n/translations/nl.ts"
      ],
      "contentia/json-api": [
        "src/shared/json-api/index.ts"
      ],
      "contentia/sanitizer": [
        "src/shared/sanitizer/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "src/impl/assets-r2/worker-configuration.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/__tests__/**"
