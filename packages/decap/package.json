{
  "name": "@contentia/decap",
  "version": "0.0.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Decap CMS backend for Contentia: a Decap admin reads and writes documents and media through the Contentia JSON:API.",
  "keywords": [
    "contentia",
    "headless",
    "content-management"
  ],
  "author": {
    "name": "Sem Postma",
    "email": "sem@contentia.dev",
    "url": "https://sem-postma.com"
  },
  "homepage": "https://github.com/contentia-dev/contentia",
  "bugs": {
    "email": "sem@contentia.dev",
    "url": "https://github.com/contentia-dev/contentia/issues"
  },
  "license": "MIT",
  "repository": "https://github.com/contentia-dev/contentia",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node ../../scripts/check-no-pnpm-catalog-deps.mjs"
  },
  "dependencies": {
    "contentia": "workspace:*"
  },
  "peerDependencies": {
    "@laikacms/decap-cms": "^4.2.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@laikacms/decap-cms": "catalog:decap",
    "@types/react": "catalog:types",
    "@types/node": "catalog:types",
    "effect": "catalog:default",
    "react": "catalog:react",
    "rimraf": "catalog:tools",
    "typescript": "catalog:tools",
    "vitest": "catalog:tools"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
