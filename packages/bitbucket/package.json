{
  "name": "@contentia/bitbucket",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Bitbucket-backed StorageRepository for Contentia via the Cloud REST v2 API. Authenticates with an app password or OAuth2 bearer token. Runtime-agnostic — only depends on `fetch`.",
  "keywords": [
    "headless-cms",
    "content-management",
    "bitbucket",
    "storage"
  ],
  "author": {
    "name": "Sem Postma",
    "email": "sem@contentia.dev",
    "url": "https://sem-postma.com"
  },
  "homepage": "https://github.com/contentia-dev/contentia",
  "bugs": {
    "email": "sem@contentia.dev",
    "url": "https://github.com/contentia-dev/contentia/issues"
  },
  "license": "MIT",
  "repository": "https://github.com/contentia-dev/contentia",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./storage-bb": {
      "types": "./dist/storage-bb/index.d.ts",
      "import": "./dist/storage-bb/index.js",
      "default": "./dist/storage-bb/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node ../../scripts/check-no-pnpm-catalog-deps.mjs"
  },
  "dependencies": {
    "contentia": "workspace:*",
    "effect": "catalog:default",
    "minimatch": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "rimraf": "catalog:tools",
    "typescript": "catalog:tools",
    "vitest": "catalog:tools"
  },
  "engines": {
    "node": ">=24"
  }
}
