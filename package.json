{
  "private": true,
  "description": "Contentia workspace root.",
  "license": "MIT",
  "repository": "https://github.com/contentia-dev/contentia",
  "scripts": {
    "clean": "rimraf --glob '**/node_modules' '**/dist' '**/.turbo' '**/cdk.out' '**/.tanstack/*' '**/.wrangler/*'",
    "build": "turbo run build",
    "dev": "turbo watch dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "coverage": "turbo run test -- --coverage --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.reporter=html",
    "lint": "eslint --cache --config eslint.config.mjs .",
    "lint:fix": "eslint --fix --cache --config eslint.config.mjs .",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "version": "changeset version",
    "smoke:cli": "turbo run build --filter=@contentia/cli && node scripts/smoke-cli-tarball.mjs",
    "security": "node scripts/security-report.mjs",
    "security:gate": "pnpm audit --prod --audit-level=critical",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "catalog:lint",
    "@types/node": "catalog:types",
    "@typescript-eslint/eslint-plugin": "catalog:lint",
    "@typescript-eslint/parser": "catalog:lint",
    "@vitest/coverage-v8": "catalog:tools",
    "dprint": "^0.64.3",
    "eslint": "catalog:lint",
    "globals": "catalog:lint",
    "husky": "^9.1.7",
    "rimraf": "catalog:tools",
    "turbo": "catalog:tools",
    "typescript": "catalog:lint",
    "typescript-eslint": "catalog:lint",
    "vitest": "catalog:tools"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=12 <13"
  }
}
