{
  "name": "@contentia/docs",
  "version": "1.0.1",
  "private": true,
  "description": "Contentia documentation site (VitePress).",
  "type": "module",
  "scripts": {
    "generate-adapter-docs": "node scripts/generate-adapter-docs.mjs",
    "generate-api-docs": "node scripts/generate-api-docs.mjs",
    "prebuild-docs": "npm run generate-adapter-docs && npm run generate-api-docs",
    "dev": "npm run prebuild-docs && vitepress dev",
    "build": "npm run prebuild-docs && vitepress build",
    "preview": "vitepress preview",
    "test": "vitest run",
    "typecheck": "tsc -p reference/examples/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "contentia": "workspace:*",
    "js-yaml": "catalog:",
    "mermaid": "catalog:docs",
    "typedoc": "catalog:docs",
    "typedoc-plugin-markdown": "catalog:docs",
    "typedoc-vitepress-theme": "catalog:docs",
    "typescript": "catalog:tools",
    "vitepress": "catalog:vue",
    "vitepress-openapi": "catalog:docs",
    "vitest": "catalog:tools",
    "vue": "catalog:vue"
  },
  "engines": {
    "node": ">=24"
  }
}
