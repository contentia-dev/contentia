{
  "version": "0.2.0",
  "configurations": [
    {
      // Runs apps/vscode against the playground fixture, whose node_modules/.bin/contentia
      // links to the local apps/cli build. CONTENTIA_CLI_PATH makes any other folder you
      // open in the dev host use the local CLI too.
      "name": "Contentia VS Code extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "${workspaceFolder}/apps/vscode/fixtures/playground"
      ],
      "env": {
        "CONTENTIA_CLI_PATH": "${workspaceFolder}/apps/cli/dist/cli.js"
      },
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.cjs"],
      "preLaunchTask": "contentia: build extension and cli"
    }
  ]
}
