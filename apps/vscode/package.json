{
  "name": "contentia-vscode",
  "private": true,
  "version": "0.0.0",
  "displayName": "Contentia",
  "description": "Browse Contentia content (folders, objects, documents) from VS Code.",
  "publisher": "contentia",
  "license": "MIT",
  "repository": "https://github.com/contentia-dev/contentia",
  "icon": "media/contentia-icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contentia",
          "title": "Contentia",
          "icon": "media/contentia.svg"
        }
      ]
    },
    "views": {
      "contentia": [
        {
          "id": "contentia.storage",
          "name": "Storage"
        },
        {
          "id": "contentia.documents",
          "name": "Documents"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "contentia.storage",
        "contents": "No Contentia connections configured.\n[Add Connection](command:contentia.addConnection)\nConnections live in the `contentia.connections` setting."
      },
      {
        "view": "contentia.documents",
        "contents": "No connection exposes a Documents API. Add a remote connection with a `documentsUrl`.\n[Add Connection](command:contentia.addConnection)"
      }
    ],
    "commands": [
      {
        "command": "contentia.refresh",
        "title": "Refresh",
        "category": "Contentia",
        "icon": "$(refresh)"
      },
      {
        "command": "contentia.addConnection",
        "title": "Add Connection",
        "category": "Contentia",
        "icon": "$(add)"
      },
      {
        "command": "contentia.restartServers",
        "title": "Restart Local Servers",
        "category": "Contentia",
        "icon": "$(debug-restart)"
      },
      {
        "command": "contentia.setAccessToken",
        "title": "Set Access Token",
        "category": "Contentia",
        "icon": "$(key)"
      },
      {
        "command": "contentia.copyKey",
        "title": "Copy Key",
        "category": "Contentia"
      },
      {
        "command": "contentia.loadMore",
        "title": "Load More",
        "category": "Contentia"
      },
      {
        "command": "contentia.open",
        "title": "Open",
        "category": "Contentia"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "contentia.refresh",
          "when": "view == contentia.storage || view == contentia.documents",
          "group": "navigation@1"
        },
        {
          "command": "contentia.addConnection",
          "when": "view == contentia.storage",
          "group": "navigation@2"
        },
        {
          "command": "contentia.restartServers",
          "when": "view == contentia.storage",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "contentia.setAccessToken",
          "when": "viewItem == connection-remote",
          "group": "inline"
        },
        {
          "command": "contentia.copyKey",
          "when": "viewItem == folder || viewItem == object || viewItem == record"
        }
      ],
      "commandPalette": [
        {
          "command": "contentia.copyKey",
          "when": "false"
        },
        {
          "command": "contentia.loadMore",
          "when": "false"
        },
        {
          "command": "contentia.open",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Contentia",
      "properties": {
        "contentia.connections": {
          "type": "array",
          "default": [],
          "markdownDescription": "Contentia content sources. A `local` connection starts `contentia local serve` through the workspace's own `@contentia/cli`; a `remote` connection talks to a deployed Contentia API server.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name; must be unique."
              },
              "type": {
                "type": "string",
                "enum": [
                  "local",
                  "remote"
                ]
              },
              "backend": {
                "type": "string",
                "default": "fs",
                "markdownDescription": "`local` only: storage backend to serve (see `contentia local list-backends`)."
              },
              "options": {
                "type": "object",
                "markdownDescription": "`local` only: backend options. For `fs`, a relative `root` resolves against the workspace folder."
              },
              "storageUrl": {
                "type": "string",
                "markdownDescription": "`remote` only: base URL of the Storage API."
              },
              "documentsUrl": {
                "type": "string",
                "markdownDescription": "`remote` only: base URL of the Documents API."
              }
            }
          }
        },
        "contentia.cli.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `@contentia/cli` entry point. Empty: use the workspace's `node_modules/.bin/contentia`, then `npx @contentia/cli`. A `.js` path runs with `node`."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@types/vscode": "^1.90.0",
    "@contentia/cli": "workspace:*",
    "contentia": "workspace:*",
    "rimraf": "catalog:tools",
    "tsup": "catalog:tools",
    "typescript": "catalog:tools",
    "vitest": "catalog:tools"
  }
}
