---
/**
 * One blog post. The route is a rest parameter because a Contentia document key
 * may be nested (`posts/2026/hello` → id `2026/hello`), and only `[...id]`
 * lets the slash survive into the URL.
 */
import { render } from 'astro:content';

import { formatDate, getPosts, type Post } from '../../data/posts';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { title, description, date, author, tags } = post.data;
const { Content } = await render(post);
---

<Base
  frontmatter={{
    title: `${title} | Contentia blog`,
    description,
    article: { publishedTime: date, author, tags },
  }}
>
  <article class="py-24 max-[760px]:py-16">
    <div class="site-container">
      <div class="max-w-[72ch] mx-auto">
        <a href="/blog" class="text-[13px] font-mono text-ink-3 transition-colors duration-150 hover:text-indigo">
          ← All posts
        </a>
        <h1 class="mt-6 text-[clamp(32px,4.2vw,48px)] font-display font-semibold tracking-[-0.02em] leading-[1.08]">
          {title}
        </h1>
        <p class="mt-5 text-[clamp(17px,1.5vw,20px)] text-ink-2 leading-[1.55]">{description}</p>
        <div class="mt-6 pb-8 border-b border-hairline flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink-3 font-mono">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{author}</span>
        </div>
        <div class="prose article-body mt-10">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>
